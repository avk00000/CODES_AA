bool initializeBMP280() {
  Serial.print("Initializing BMP280 (Secondary)... ");
  // Try default I2C address 0x76, if fails try 0x77
  if (!bmp280.begin(0x76)) {
    Serial.print("Address 0x76 failed, trying 0x77... ");
    if (!bmp280.begin(0x77)) {
      Serial.println("FAILED");
      return false;
    }
  }
  
  // Configure BMP280 for high accuracy
  bmp280.setSampling(Adafruit_BMP280::MODE_NORMAL,     // Operating Mode
                    Adafruit_BMP280::SAMPLING_X2,      // Temperature oversampling
                    Adafruit_BMP280::SAMPLING_X16,     // Pressure oversampling
                    Adafruit_BMP280::FILTER_X16,       // Filtering
                    Adafruit_BMP280::STANDBY_MS_500);  // Standby time
  
  Serial.println("SUCCESS");
  return true;
}

void calibrateAltitudeDualSensor() {
  Serial.println("\n=== DUAL SENSOR ALTITUDE CALIBRATION ===");
  sendHC12Data("STATUS:Calibrating dual sensors...");
  
  const int numReadings = 50;
  float sumPressureMS5611 = 0;
  float sumPressureBMP280 = 0;
  int validMS5611 = 0;
  int validBMP280 = 0;
  
  for (int i = 0; i < numReadings; i++) {
    if (ms5611Available) {
      ms5611.read();
      float pressMS = ms5611.getPressure();
      if (pressMS > 0) {
        sumPressureMS5611 += pressMS;
        validMS5611++;
      }
    }
    
    if (bmp280Available) {
      float pressBMP = bmp280.readPressure() / 100.0; // Convert Pa to hPa
      if (pressBMP > 0) {
        sumPressureBMP280 += pressBMP;
        validBMP280++;
      }
    }
    
    delay(20);
    if (i % 10 == 0) Serial.print(".");
  }
  
  Serial.println();
  
  if (validMS5611 > 0) {
    referencePressureMS5611 = sumPressureMS5611 / validMS5611;
    Serial.printf("MS5611 Reference Pressure: %.2f hPa (%d valid readings)\n", 
                  referencePressureMS5611, validMS5611);
    sendHC12Data("CALIBRATION:MS5611_RefPress=" + String(referencePressureMS5611, 2) + "hPa");
  }
  
  if (validBMP280 > 0) {
    referencePressureBMP280 = sumPressureBMP280 / validBMP280;
    Serial.printf("BMP280 Reference Pressure: %.2f hPa (%d valid readings)\n", 
                  referencePressureBMP280, validBMP280);
    sendHC12Data("CALIBRATION:BMP280_RefPress=" + String(referencePressureBMP280, 2) + "hPa");
  }
  
  // Calculate initial sensor variance for adaptive weighting
  updateSensorWeights();
  
  Serial.printf("Initial Sensor Weights: MS5611=%.3f, BMP280=%.3f\n", ms5611Weight, bmp280Weight);
  sendHC12Data("CALIBRATION:Weights MS5611=" + String(ms5611Weight, 3) + 
               " BMP280=" + String(bmp280Weight, 3));
  
  Serial.println("=== CALIBRATION COMPLETE ===\n");
}

float calculateAltitude(float pressure, float referencePressure) {
  if (pressure > 0 && referencePressure > 0) {
    return 44330.0 * (1.0 - pow(pressure / referencePressure, 0.1903));
  }
  return 0.0;
}

void readAndFuseAltitude() {
  float altMS5611 = 0;
  float altBMP280 = 0;
  bool ms5611Valid = false;
  bool bmp280Valid = false;
  
  // Read MS5611
  if (ms5611Available) {
    ms5611.read();
    float pressMS = ms5611.getPressure();
    if (pressMS > 0) {
      altMS5611 = calculateAltitude(pressMS, referencePressureMS5611);
      ms5611Valid = true;
      
      // Store for reliability tracking
      ms5611ReadingsHistory[reliabilityIndex] = altMS5611;
    }
  }
  
  // Read BMP280
  if (bmp280Available) {
    float pressBMP = bmp280.readPressure() / 100.0; // Convert Pa to hPa
    if (pressBMP > 0) {
      altBMP280 = calculateAltitude(pressBMP, referencePressureBMP280);
      bmp280Valid = true;
      
      // Store for reliability tracking
      bmp280ReadingsHistory[reliabilityIndex] = altBMP280;
    }
  }
  
  reliabilityIndex = (reliabilityIndex + 1) % RELIABILITY_WINDOW;
  
  // Fuse altitude readings using weighted average
  float fusedAltitude = 0;
  
  if (ms5611Valid && bmp280Valid) {
    // Both sensors valid - use weighted fusion
    fusedAltitude = (altMS5611 * ms5611Weight) + (altBMP280 * bmp280Weight);
    
    // Apply Kalman filter for smoothing
    fusedAltitude = applyKalmanFilter(fusedAltitude);
    
    // Update sensor weights based on variance
    if (reliabilityIndex == 0) { // Update weights every cycle
      updateSensorWeights();
    }
  }
  else if (ms5611Valid) {
    // Only MS5611 valid
    fusedAltitude = applyKalmanFilter(altMS5611);
    ms5611Weight = 1.0;
    bmp280Weight = 0.0;
  }
  else if (bmp280Valid) {
    // Only BMP280 valid
    fusedAltitude = applyKalmanFilter(altBMP280);
    ms5611Weight = 0.0;
    bmp280Weight = 1.0;
  }
  else {
    // No valid readings - use last known altitude
    fusedAltitude = lastFusedAltitude;
    sendHC12Data("WARNING:No valid altitude readings");
  }
  
  // Add to moving average filter
  altitudeSum -= altitudeReadings[altitudeReadingsIndex];
  altitudeReadings[altitudeReadingsIndex] = fusedAltitude;
  altitudeSum += fusedAltitude;
  
  altitudeReadingsIndex = (altitudeReadingsIndex + 1) % ALTITUDE_FILTER_SIZE;
  if (altitudeReadingsIndex == 0) altitudeFilterFilled = true;
  
  lastFusedAltitude = fusedAltitude;
}

float applyKalmanFilter(float measurement) {
  // Prediction step
  float predictedAltitude = lastFusedAltitude + altitudeVelocity;
  kalmanP = kalmanP + KALMAN_Q;
  
  // Update step
  float kalmanK = kalmanP / (kalmanP + KALMAN_R);
  float filteredAltitude = predictedAltitude + kalmanK * (measurement - predictedAltitude);
  kalmanP = (1 - kalmanK) * kalmanP;
  
  // Update velocity estimate
  altitudeVelocity = filteredAltitude - lastFusedAltitude;
  
  return filteredAltitude;
}

void updateSensorWeights() {
  // Calculate variance for each sensor
  float ms5611Variance = 0;
  float bmp280Variance = 0;
  
  if (ms5611Available) {
    float ms5611Mean = 0;
    for (int i = 0; i < RELIABILITY_WINDOW; i++) {
      ms5611Mean += ms5611ReadingsHistory[i];
    }
    ms5611Mean /= RELIABILITY_WINDOW;
    
    for (int i = 0; i < RELIABILITY_WINDOW; i++) {
      float diff = ms5611ReadingsHistory[i] - ms5611Mean;
      ms5611Variance += diff * diff;
    }
    ms5611Variance /= RELIABILITY_WINDOW;
  }
  
  if (bmp280Available) {
    float bmp280Mean = 0;
    for (int i = 0; i < RELIABILITY_WINDOW; i++) {
      bmp280Mean += bmp280ReadingsHistory[i];
    }
    bmp280Mean /= RELIABILITY_WINDOW;
    
    for (int i = 0; i < RELIABILITY_WINDOW; i++) {
      float diff = bmp280ReadingsHistory[i] - bmp280Mean;
      bmp280Variance += diff * diff;
    }
    bmp280Variance /= RELIABILITY_WINDOW;
  }
  
  // Calculate weights inversely proportional to variance
  // Lower variance = higher weight (more reliable)
  if (ms5611Available && bmp280Available) {
    if (ms5611Variance > 0 && bmp280Variance > 0) {
      float ms5611Precision = 1.0 / (ms5611Variance + 0.001); // Add small value to avoid division by zero
      float bmp280Precision = 1.0 / (bmp280Variance + 0.001);
      
      float totalPrecision = ms5611Precision + bmp280Precision;
      
      ms5611Weight = ms5611Precision / totalPrecision;
      bmp280Weight = bmp280Precision / totalPrecision;
      
      // Apply smoothing to weight changes
      const float WEIGHT_SMOOTHING = 0.9;
      static float lastMS5611Weight = 0.5;
      static float lastBMP280Weight = 0.5;
      
      ms5611Weight = WEIGHT_SMOOTHING * lastMS5611Weight + (1 - WEIGHT_SMOOTHING) * ms5611Weight;
      bmp280Weight = WEIGHT_SMOOTHING * lastBMP280Weight + (1 - WEIGHT_SMOOTHING) * bmp280Weight;
      
      lastMS5611Weight = ms5611Weight;
      lastBMP280Weight = bmp280Weight;
    }
  }
  else if (ms5611Available) {
    ms5611Weight = 1.0;
    bmp280Weight = 0.0;
  }
  else if (bmp280Available) {
    ms5611Weight = 0.0;
    bmp280Weight = 1.0;
  }
}

float getSmoothedAltitude() {
  int count = altitudeFilterFilled ? ALTITUDE_FILTER_SIZE : altitudeReadingsIndex;
  return count > 0 ? altitudeSum / count : 0;
}

void readMPU6050(float &roll, float &pitch, float &accX, float &accY, float &accZ) {
  sensors_event_t a, g, temp;
  mpu.getEvent(&a, &g, &temp);
  
  accX = a.acceleration.x;
  accY = a.acceleration.y;
  accZ = a.acceleration.z;
  
  roll = atan2(accY, accZ) * 180 / PI;
  pitch = atan(-accX / sqrt(accY * accY + accZ * accZ)) * 180 / PI;
}

void systemHalt(String message) {
  Serial.println("❌ CRITICAL ERROR: " + message);
  logData("SYSTEM_HALT", message);
  
  // Send error via HC-12
  sendHC12Data("ERROR:❌ CRITICAL ERROR!");
  sendHC12Data("ERROR:" + message);
  sendHC12Data("STATUS:SYSTEM HALTED");
  
  while (true) {
    blinkLED(statusLedPin, 200);
    blinkLED(deployLedPin, 200);
    delay(100);
  }
}

void initializeAltitudeFilter() {
  for (int i = 0; i < ALTITUDE_FILTER_SIZE; i++) {
    altitudeReadings[i] = 0.0;
  }
  altitudeSum = 0;
  altitudeReadingsIndex = 0;
  altitudeFilterFilled = false;
  
  // Initialize reliability tracking arrays
  for (int i = 0; i < RELIABILITY_WINDOW; i++) {
    ms5611ReadingsHistory[i] = 0.0;
    bmp280ReadingsHistory[i] = 0.0;
  }
  
  // Initialize altitude history
  for (int i = 0; i < ALTITUDE_HISTORY_SIZE; i++) {
    altitudeHistory[i] = 0.0;
    altitudeTimeHistory[i] = 0;
  }
}

void blinkLED(int ledPin, int interval) {
  static unsigned long lastBlink = 0;
  static bool ledState = false;
  
  if (millis() - lastBlink >= interval) {
    ledState = !ledState;
    digitalWrite(ledPin, ledState);
    lastBlink = millis();
  }
}
