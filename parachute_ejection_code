bool initializeSDCard() {
  Serial.print("Initializing SD Card... ");
  
  if (!SD.begin(chipSelect, SPI, 4000000)) {
    Serial.println("FAILED");
    return false;
  }
  
  uint8_t cardType = SD.cardType();
  if (cardType == CARD_NONE) {
    Serial.println("NO CARD");
    return false;
  }
  
  // Find next session number
  sessionNumber = 1;
  while (SD.exists("/session" + String(sessionNumber) + ".csv")) {
    sessionNumber++;
  }
  
  fileName = "/session" + String(sessionNumber) + ".csv";
  
  dataFile = SD.open(fileName, FILE_WRITE);
  if (!dataFile) {
    Serial.println("FILE CREATION FAILED");
    return false;
  }
  dataFile.close();
  
  Serial.println("SUCCESS");
  Serial.printf("Session: %d, File: %s\n", sessionNumber, fileName.c_str());
  Serial.printf("Card Size: %.1f MB\n", SD.cardSize() / (1024.0 * 1024.0));
  
  sdInitialized = true;
  return true;
}

