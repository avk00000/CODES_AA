void loop() {
  if (parachuteDeployed) {
    // After deployment, maintain system state
    blinkLED(deployLedPin, 500);
    logData("PARACHUTE_STATUS", "Parachute deployed - System in safe mode");
    
    // Send deployment status via HC-12 periodically
    static unsigned long lastDeployMsg = 0;
    if (millis() - lastDeployMsg >= 2000) {
      lastDeployMsg = millis();
      sendHC12Data("STATUS:Parachute Deployed - Safe Mode");
      sendHC12Data("DEPLOY_REASON:" + deploymentCondition);  // Send deployment reason
    }
    
    delay(1000);
    return;
  }
  
  unsigned long currentTime = millis();
  float timestamp = (currentTime - systemStartTime) / 1000.0;
  
  // Read sensors at higher rate
  if (currentTime - lastAltitudeReadTime >= ALTITUDE_READ_INTERVAL) {
    lastAltitudeReadTime = currentTime;
    readAndFuseAltitude();
  }
  
  float roll = 0, pitch = 0;
  float accelerationX = 0, accelerationY = 0, accelerationZ = 0;
  readMPU6050(roll, pitch, accelerationX, accelerationY, accelerationZ);
  
  float altitude = getSmoothedAltitude();
  
  // Store altitude history for rate calculation
  storeAltitudeHistory(altitude, currentTime);
  
  // Send live sensor data via HC-12 at higher rate
  if (currentTime - lastHC12TransmitTime >= HC12_TRANSMIT_INTERVAL) {
    lastHC12TransmitTime = currentTime;
    sendLiveSensorData(timestamp, roll, pitch, accelerationX, accelerationY, accelerationZ, altitude);
  }
  
  // Send sensor diagnostics periodically
  if (currentTime - lastDiagnosticTime >= DIAGNOSTIC_INTERVAL) {
    lastDiagnosticTime = currentTime;
    sendSensorDiagnostics();
  }
  
  // Check altitude activation
  if (!systemActive) {
    if (altitude >= ALTITUDE_ACTIVATION_THRESHOLD) {
      systemActive = true;
      Serial.println("\n>>> SYSTEM ARMED <<<");
      Serial.println(">>> MONITORING FOR FREE FALL CONDITIONS <<<");
      digitalWrite(statusLedPin, HIGH);
      logData("SYSTEM_ARMED", "Altitude threshold reached. Monitoring active.");
      logColumnHeaders();
      
      // Send armed alert via HC-12
      sendHC12Data("ALERT:SYSTEM ARMED!");
      sendHC12Data("ALERT:Altitude threshold reached");
      sendHC12Data("STATUS:Monitoring for free fall");
    }
    
    // Log waiting status periodically
    if (currentTime - lastLogTime >= LOG_INTERVAL) {
      lastLogTime = currentTime;
      String altMsg = "Current altitude: " + String(altitude, 2) + "m, Waiting for: " + String(ALTITUDE_ACTIVATION_THRESHOLD, 1) + "m";
      logData("WAITING", altMsg);
      Serial.println(altMsg);
    }
    delay(20);  // Reduced delay for faster response
    return;
  }
  
  // Regular logging when armed at higher rate
  if (currentTime - lastLogTime >= LOG_INTERVAL) {
    lastLogTime = currentTime;
    logSensorData(timestamp, roll, pitch, accelerationX, accelerationY, accelerationZ, altitude, "NORMAL");
  }
  
  // Check for ALL deployment conditions
  checkDeploymentConditions(timestamp, altitude, roll, pitch, accelerationX, accelerationY, accelerationZ);
  
  delay(20);  // Reduced delay for faster loop
}

// Function to send data via HC-12
void sendHC12Data(String data) {
  HC12.println(data);
  delay(10); // Small delay to ensure transmission
}

// Function to send live sensor data in formatted way
void sendLiveSensorData(float timestamp, float roll, float pitch, float accX, float accY, float accZ, float altitude) {
  // Calculate additional parameters
  float totalAcc = sqrt(accX*accX + accY*accY + accZ*accZ);
  float verticalVelocity = calculateVerticalVelocity();
  
  // Create formatted data string
  String dataPacket = "DATA:";
  dataPacket += "T=" + String(timestamp, 2) + "s,";
  dataPacket += "R=" + String(roll, 2) + "°,";
  dataPacket += "P=" + String(pitch, 2) + "°,";
  dataPacket += "AX=" + String(accX, 2) + ",";
  dataPacket += "AY=" + String(accY, 2) + ",";
  dataPacket += "AZ=" + String(accZ, 2) + ",";
  dataPacket += "ALT=" + String(altitude, 2) + "m,";
  dataPacket += "TotalAcc=" + String(totalAcc, 2) + ",";
  dataPacket += "VelZ=" + String(verticalVelocity, 2);
  
  sendHC12Data(dataPacket);
  
  // Send system status
  if (!systemActive) {
    sendHC12Data("STATUS:Waiting for altitude activation");
  } else {
    sendHC12Data("STATUS:Armed - Monitoring");
  }
}

// Function to send sensor diagnostics
void sendSensorDiagnostics() {
  String diag = "DIAGNOSTICS:";
  diag += "MS5611_Weight=" + String(ms5611Weight, 3) + ",";
  diag += "BMP280_Weight=" + String(bmp280Weight, 3) + ",";
  diag += "Kalman_P=" + String(kalmanP, 4);
  sendHC12Data(diag);
}

void storeAltitudeHistory(float altitude, unsigned long timestamp) {
  altitudeHistory[altitudeHistoryIndex] = altitude;
  altitudeTimeHistory[altitudeHistoryIndex] = timestamp;
  
  altitudeHistoryIndex = (altitudeHistoryIndex + 1) % ALTITUDE_HISTORY_SIZE;
  if (altitudeHistoryIndex == 0) altitudeHistoryFilled = true;
}

float calculateVerticalVelocity() {
  if (!altitudeHistoryFilled && altitudeHistoryIndex < 2) {
    return 0.0;
  }
  
  int samples = altitudeHistoryFilled ? ALTITUDE_HISTORY_SIZE : altitudeHistoryIndex;
  if (samples < 2) return 0.0;
  
  // Get oldest and newest samples
  int oldestIndex = altitudeHistoryFilled ? altitudeHistoryIndex : 0;
  int newestIndex = (altitudeHistoryIndex - 1 + ALTITUDE_HISTORY_SIZE) % ALTITUDE_HISTORY_SIZE;
  
  float altitudeDiff = altitudeHistory[newestIndex] - altitudeHistory[oldestIndex];
  float timeDiff = (altitudeTimeHistory[newestIndex] - altitudeTimeHistory[oldestIndex]) / 1000.0; // Convert to seconds
  
  if (timeDiff > 0) {
    return altitudeDiff / timeDiff;  // meters per second
  }
  
  return 0.0;
}

bool isAltitudeDropping() {
  float verticalVelocity = calculateVerticalVelocity();
  return (verticalVelocity < ALTITUDE_DROP_RATE_THRESHOLD);
}

// ENHANCED FREE FALL DETECTION WITH MULTIPLE PARAMETERS
void checkDeploymentConditions(float timestamp, float altitude, float roll, float pitch, 
                               float accX, float accY, float accZ) {
  
  // Calculate total acceleration (magnitude)
  float totalAcceleration = sqrt(accX*accX + accY*accY + accZ*accZ);
  
  // Calculate vertical velocity
  float verticalVelocity = calculateVerticalVelocity();
  
  // Calculate lateral acceleration
  float lateralAcceleration = sqrt(accX*accX + accY*accY);
  
  // ==================== CONDITION 1: ADVANCED FREE FALL DETECTION ====================
  bool advancedFreeFallDetected = false;
  String freeFallReason = "";
  
  // Multi-parameter free fall check
  bool lowVerticalAcc = (fabs(accZ) < FREE_FALL_ACCELERATION_THRESHOLD && fabs(accZ) > 0.1);
  bool nearZeroG = (totalAcceleration >= FREE_FALL_TOTAL_ACC_MIN && totalAcceleration <= FREE_FALL_TOTAL_ACC_MAX);
  bool rapidDescent = isAltitudeDropping();
  bool lowLateralAcc = (lateralAcceleration < XY_ACCELERATION_THRESHOLD);
  bool fallingDown = (verticalVelocity < VERTICAL_VELOCITY_THRESHOLD);
  
  // Count how many conditions are met
  int freeFallScore = 0;
  if (lowVerticalAcc) freeFallScore++;
  if (nearZeroG) freeFallScore++;
  if (rapidDescent) freeFallScore++;
  if (lowLateralAcc) freeFallScore++;
  if (fallingDown) freeFallScore++;
  
  // Require at least 3 out of 5 conditions for robust detection
  if (freeFallScore >= 3) {
    advancedFreeFallDetected = true;
    
    // Build detailed reason
    freeFallReason = "FreeFall[Score:" + String(freeFallScore) + "/5]:";
    if (lowVerticalAcc) freeFallReason += "LowAccZ=" + String(accZ, 2) + ",";
    if (nearZeroG) freeFallReason += "TotalAcc=" + String(totalAcceleration, 2) + ",";
    if (rapidDescent) freeFallReason += "AltDrop=" + String(verticalVelocity, 2) + "m/s,";
    if (lowLateralAcc) freeFallReason += "LowXY=" + String(lateralAcceleration, 2) + ",";
    if (fallingDown) freeFallReason += "Falling";
    
    if (!freeFallConditionMet) {
      freeFallConditionMet = true;
      freeFallDetectionStart = millis();
      
      // Send detailed threshold alert
      sendHC12Data("THRESHOLD:FREE FALL - Multi-Parameter Detection!");
      sendHC12Data("THRESHOLD:Score=" + String(freeFallScore) + "/5 conditions met");
      if (lowVerticalAcc) sendHC12Data("THRESHOLD:✓ Low Vertical Acc: " + String(accZ, 2) + " m/s²");
      if (nearZeroG) sendHC12Data("THRESHOLD:✓ Near Zero-G: " + String(totalAcceleration, 2) + " m/s²");
      if (rapidDescent) sendHC12Data("THRESHOLD:✓ Rapid Descent: " + String(verticalVelocity, 2) + " m/s");
      if (lowLateralAcc) sendHC12Data("THRESHOLD:✓ Low Lateral Acc: " + String(lateralAcceleration, 2) + " m/s²");
      if (fallingDown) sendHC12Data("THRESHOLD:✓ Vertical Velocity: " + String(verticalVelocity, 2) + " m/s");
    }
  }
  
  // ==================== CONDITION 2: EXCESSIVE ROLL ====================
  bool rollExceeded = (fabs(roll) > ORIENTATION_THRESHOLD);
  if (rollExceeded) {
    if (!rollConditionMet) {
      rollConditionMet = true;
      rollDetectionStart = millis();
      
      String alert = "THRESHOLD:EXCESSIVE ROLL! Roll=" + String(roll, 2) + "° > " + String(ORIENTATION_THRESHOLD, 1) + "°";
      sendHC12Data(alert);
    }
  }
  
  // ==================== CONDITION 3: EXCESSIVE PITCH ====================
  bool pitchExceeded = (fabs(pitch) > ORIENTATION_THRESHOLD);
  if (pitchExceeded) {
    if (!pitchConditionMet) {
      pitchConditionMet = true;
      pitchDetectionStart = millis();
      
      String alert = "THRESHOLD:EXCESSIVE PITCH! Pitch=" + String(pitch, 2) + "° > " + String(ORIENTATION_THRESHOLD, 1) + "°";
      sendHC12Data(alert);
    }
  }
  
  // ==================== CHECK WHICH CONDITIONS ARE ACTIVE ====================
  bool anyConditionActive = advancedFreeFallDetected || rollExceeded || pitchExceeded;
  
  if (anyConditionActive) {
    // Determine which condition was detected first
    unsigned long earliestDetection = ULONG_MAX;
    String deploymentReason = "";
    
    if (freeFallConditionMet && freeFallDetectionStart < earliestDetection) {
      earliestDetection = freeFallDetectionStart;
      deploymentReason = "FREE_FALL";
      deploymentCondition = freeFallReason;
    }
    
    if (rollConditionMet && rollDetectionStart < earliestDetection) {
      earliestDetection = rollDetectionStart;
      deploymentReason = "EXCESSIVE_ROLL";
      deploymentCondition = "Excessive_Roll:" + String(roll, 2) + "°";
    }
    
    if (pitchConditionMet && pitchDetectionStart < earliestDetection) {
      earliestDetection = pitchDetectionStart;
      deploymentReason = "EXCESSIVE_PITCH";
      deploymentCondition = "Excessive_Pitch:" + String(pitch, 2) + "°";
    }
    
    if (fallStartTime == 0) {
      // First detection overall
      fallStartTime = earliestDetection;
      triggerReason = deploymentCondition;
      storeDetectionValues(timestamp, altitude, roll, pitch, accX, accY, accZ, totalAcceleration, verticalVelocity);
      
      Serial.println("\n⚠️  POTENTIAL DEPLOYMENT CONDITION DETECTED");
      Serial.println("⏳ Beginning confirmation period...");
      Serial.println("📊 Condition: " + deploymentReason);
      logData("CONDITION_DETECTED", "Confirming: " + deploymentCondition);
      
      // Send alerts via HC-12
      sendHC12Data("ALERT:⚠️ DEPLOYMENT CONDITION DETECTED!");
      sendHC12Data("ALERT:Condition: " + deploymentReason);
      sendHC12Data("ALERT:Details: " + deploymentCondition);
      sendHC12Data("ALERT:Confirmation period started");
      
      blinkLED(statusLedPin, 100);
      blinkLED(deployLedPin, 100);
    }
    else if (millis() - fallStartTime >= CONFIRMATION_TIME) {
      // Confirmed deployment condition
      deployParachute(timestamp, deploymentReason);
    }
    else {
      // Send countdown update
      unsigned long remaining = CONFIRMATION_TIME - (millis() - fallStartTime);
      String countdownMsg = "COUNTDOWN:Confirming " + deploymentReason + "... " + String(remaining) + "ms remaining";
      sendHC12Data(countdownMsg);
    }
  }
  else {
    // All conditions cleared
    if (fallStartTime != 0) {
      Serial.println("✅ All deployment conditions cleared");
      logData("CONDITION_CLEARED", "Deployment detection reset");
      
      // Send clear alert via HC-12
      sendHC12Data("ALERT:✅ All Conditions Cleared - Reset");
      sendHC12Data("STATUS:Monitoring resumed");
      
      fallStartTime = 0;
      freeFallConditionMet = false;
      rollConditionMet = false;
      pitchConditionMet = false;
      digitalWrite(statusLedPin, HIGH);
      digitalWrite(deployLedPin, HIGH);
    }
  }
}

