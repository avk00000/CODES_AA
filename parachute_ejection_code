void setup() {
  // Initialize pins
  pinMode(statusLedPin, OUTPUT);
  pinMode(deployLedPin, OUTPUT);
  
  // Start with both LEDs ON
  digitalWrite(statusLedPin, HIGH);
  digitalWrite(deployLedPin, HIGH);
  
  // Initialize serial for debugging
  Serial.begin(115200);
  while (!Serial) {
    ; // wait for serial port to connect
  }
  
  // Initialize HC-12 Serial Communication
  HC12.begin(9600, SERIAL_8N1, HC12_RX, HC12_TX);
  delay(100);
  Serial.println("HC-12 Wireless Module Initialized");
  sendHC12Data("SYSTEM:HC-12 Initialized");
  
  Serial.println("\n==============================================");
  Serial.println("    PARACHUTE EJECTION SYSTEM INITIALIZATION");
  Serial.println("    DUAL SENSOR FUSION (MS5611 + BMP280)");
  Serial.println("    ADVANCED FREE FALL DETECTION");
  Serial.println("==============================================\n");
  
  // Initialize I2C bus
  Wire.begin();
  Wire.setClock(400000);
  Serial.println("I2C Bus Initialized");
  sendHC12Data("SYSTEM:I2C Bus Initialized");
  
  // Initialize SD card first
  if (!initializeSDCard()) {
    Serial.println("WARNING: Continuing without SD card logging");
    sendHC12Data("WARNING:SD Card logging disabled");
  } else {
    sendHC12Data("SYSTEM:SD Card initialized");
  }
  
  // Initialize sensors
  if (!initializeMPU6050()) {
    systemHalt("MPU6050 initialization failed!");
  }
  sendHC12Data("SYSTEM:MPU6050 Initialized");
  
  // Initialize MS5611 (Primary barometer)
  if (!initializeMS5611()) {
    Serial.println("WARNING: MS5611 not available - Will use BMP280 only");
    sendHC12Data("WARNING:MS5611 not available");
    ms5611Available = false;
  } else {
    ms5611Available = true;
    sendHC12Data("SYSTEM:MS5611 Initialized (Primary)");
  }
  
  // Initialize BMP280 (Secondary barometer)
  if (!initializeBMP280()) {
    Serial.println("WARNING: BMP280 not available - Will use MS5611 only");
    sendHC12Data("WARNING:BMP280 not available");
    bmp280Available = false;
  } else {
    bmp280Available = true;
    sendHC12Data("SYSTEM:BMP280 Initialized (Secondary)");
  }
  
  // Check if at least one barometer is available
  if (!ms5611Available && !bmp280Available) {
    systemHalt("CRITICAL: No barometric sensors available!");
  }
  
  // Initialize altitude filter
  initializeAltitudeFilter();
  
  // Calibrate altitude to zero at startup with dual sensor fusion
  calibrateAltitudeDualSensor();
  
  // Initialize servo
  parachuteServo.attach(servoPin);
  parachuteServo.write(0);
  Serial.println("Servo Motor Initialized (Closed Position)");
  sendHC12Data("SYSTEM:Servo Initialized");
  
  // System starts automatically when powered on
  systemStartTime = millis();
  
  Serial.println("\n>>> SYSTEM ACTIVATED <<<");
  Serial.println(">>> ADVANCED FREE FALL DETECTION ENABLED <<<");
  Serial.println(">>> WAITING FOR ALTITUDE THRESHOLD <<<");
  Serial.printf("Activation Altitude: %.1f meters\n", ALTITUDE_ACTIVATION_THRESHOLD);
  Serial.printf("Free Fall Threshold: %.1f m/s²\n", FREE_FALL_ACCELERATION_THRESHOLD);
  Serial.printf("Orientation Threshold: %.1f degrees\n", ORIENTATION_THRESHOLD);
  Serial.printf("Altitude Drop Rate: %.1f m/s\n", ALTITUDE_DROP_RATE_THRESHOLD);
  Serial.printf("Confirmation Time: %d ms\n", CONFIRMATION_TIME);
  Serial.printf("Sensor Fusion: MS5611=%s, BMP280=%s\n", 
                ms5611Available ? "ACTIVE" : "INACTIVE",
